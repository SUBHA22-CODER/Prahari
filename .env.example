# PRAHARI-AI Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# ─── PostgreSQL + PostGIS Connection ─────────────────────────────────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://prahari:prahari_pass@db:5432/prahari_db

# Async connection (used by asyncpg if needed)
ASYNC_DATABASE_URL=postgresql+asyncpg://prahari:prahari_pass@db:5432/prahari_db

# ─── ISRO Bhuvan API Token ────────────────────────────────────────────────────
# Request access at: https://bhuvan-app1.nrsc.gov.in/api/
# Request this on Day 1 in parallel with all other setup — never let token
# approval sit on the critical path (Build Guide §3.1, §3.5).
BHUVAN_TOKEN=a140b66e367654d5b27a8b397c82dfbf2c19b59d

# ─── NASA FIRMS MAP_KEY ───────────────────────────────────────────────────────
# Free, no-cost key obtained by registering at: https://firms.modaps.eosdis.nasa.gov/api/
# No payment required — registration only.
FIRMS_MAP_KEY=96573803e4ca36eddc3967a446c6e2a1

# ─── Application Settings ────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Pilot district identifier (used by fetchers to scope queries)
PILOT_DISTRICT=Wayanad

# ─── Brevo SMTP Email Integration ───────────────────────────────────────────
# Get SMTP relay keys from your Brevo (Sendinblue) dashboard settings.
BREVO_SMTP_LOGIN=your_brevo_smtp_login_email@example.com
BREVO_SMTP_KEY=your_brevo_api_smtp_key_here
BREVO_SENDER_EMAIL=prahari.ai@gmail.com

# ─── NOTE ─────────────────────────────────────────────────────────────────────
# Open-Meteo (rainfall): No API key required.
# CWC / India-WRIS: No key required; uses HTML scraper.
# USGS Earthquake: No key required.
# OpenStreetMap / Overpass: No key required.
# INCOIS tsunami OPR: No key required.
# Census / SECC: Static bulk download — no key required.
